{
	"name": "erp-backend",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"dev": {
		"port": 8788
	},
	"assets": {
		"directory": "../erp-frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "erp-db",
			"database_id": "local-d1-id"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "erp-files"
		}
	],
	"triggers": {
		// Hourly dispatcher tick for the scheduled() handler in src/index.ts - it evaluates
		// job_cron_schedules (per-institution cron expressions, e.g. nightly backups) and
		// enqueues anything due, then drains the background job queue. Previously this
		// scheduled() export existed but was never actually wired to a real Cron Trigger.
		"crons": ["0 * * * *"]
	}
}
